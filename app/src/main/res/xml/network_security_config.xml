<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for any HTTP streams (some m3u8 sources are http) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
