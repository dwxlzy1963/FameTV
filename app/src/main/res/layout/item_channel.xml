<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel row in the country-grouped list. Horizontal layout:
  [favorite ★] [channel name]                [subtitle / country]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_channel_card_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/channel_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:layout_marginEnd="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/channel_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
