<?xml version="1.0" encoding="utf-8"?>
<!--
  Country group header row. Wide and tall enough to be easily focused
  with a TV remote. Shows country name + channel count, with a triangle
  arrow icon that rotates 90° when expanded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_country_header_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:minHeight="56dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/expand_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_expand"
        android:tint="@color/accent"
        android:contentDescription="@string/expand" />

    <TextView
        android:id="@+id/country_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/country_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp" />
</LinearLayout>
