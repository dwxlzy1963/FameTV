<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel row for the Favorites / History list (vertical layout).

  Two-line layout so long channel names are NOT truncated:
    Line 1: [★] Channel name (full, multi-line if needed)
    Line 2: subtitle (country · language · GEO)

  This is different from item_channel.xml (which is a compact horizontal row
  used inside the country-grouped main list).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_channel_card_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:minHeight="72dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/channel_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:layout_marginEnd="14dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/channel_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
